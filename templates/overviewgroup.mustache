<div class="box generalbox groupcontainer p-y-1 {{#inactive}}dimmed_text{{/inactive}}"
     id="yui_3_17_2_1_1494398782636_28">

    <div class="groupinfo">
        <h3>
            {{name}}
            {{#outdated}}
                <small class="p-l-1">
                    <i class="fa fa-user-circle text-info"
                       title="{{#str}}not_synced_reg_present, mod_grouptool{{/str}}"
                       aria-hidden="true">
                    </i>
                </small>
            {{/outdated}}
        </h3>

        {{#downloadcapability}}
            <div class="download">
                <span class="title">
                    {{#str}}download, core{{/str}}:
                </span>

                <a href="{{downloadurl}}&format={{formattxt}}">.TXT</a>
                <a href="{{downloadurl}}&format={{formatxlsx}}">.XLSX</a>
                <a href="{{downloadurl}}&format={{formatpdf}}">.PDF</a>
                <a href="{{downloadurl}}&format={{formatods}}">.ODS</a>
            </div>
        {{/downloadcapability}}

        <span class="groupsize">
            {{#str}}total, mod_grouptool{{/str}} {{total}}
        </span>
        /
        <span class="registered">
            {{#str}}registered, mod_grouptool{{/str}} {{registered}}
        </span>
        /
        <span class="queued">
            {{#str}}queued, mod_grouptool{{/str}} {{queued}}
        </span>
        /
        <span class="free">
            {{#str}}free, mod_grouptool{{/str}} {{free}}
        </span>
    </div>

    <table class="centeredblock userlist table table-striped table-hover table-condensed grouptool-user-table">
        <thead>
        <tr>
            <th class="text-center">
                {{#str}}status, mod_grouptool{{/str}}
                {{#statushelp}}
                    {{>core/help_icon}}
                {{/statushelp}}
            </th>

            <th>
                <button type="button"
                        class="btn btn-link p-0 grouptool-sort-name"
                        data-sort-field="lastname"
                        aria-label="{{#str}}lastname{{/str}}">

                    {{#str}}lastname{{/str}}

                    <i class="fa fa-sort grouptool-sort-default"
                       aria-hidden="true">
                    </i>

                    <i class="fa fa-sort-up grouptool-sort-ascending d-none"
                       aria-hidden="true">
                    </i>

                    <i class="fa fa-sort-down grouptool-sort-descending d-none"
                       aria-hidden="true">
                    </i>
                </button>

                /

                <button type="button"
                        class="btn btn-link p-0 grouptool-sort-name"
                        data-sort-field="firstname"
                        aria-label="{{#str}}firstname{{/str}}">

                    {{#str}}firstname{{/str}}

                    <i class="fa fa-sort grouptool-sort-default"
                       aria-hidden="true">
                    </i>

                    <i class="fa fa-sort-up grouptool-sort-ascending d-none"
                       aria-hidden="true">
                    </i>

                    <i class="fa fa-sort-down grouptool-sort-descending d-none"
                       aria-hidden="true">
                    </i>
                </button>
            </th>

            {{#useridentity}}
                <th>
                    {{value}}
                </th>
            {{/useridentity}}
        </tr>
        </thead>

        <tbody>
        {{#reg_data}}
            <tr class="grouptool-sortable-user"
                data-firstname="{{firstname}}"
                data-lastname="{{lastname}}">

                <td class="status">
                    {{status}}
                </td>

                <td class="userlink">
                    <a href="{{userlink}}&id={{userid}}"
                    title="{{name}}">
                    {{name}}
                    </a>
                </td>

                {{#useridentityvalues}}
                    <td class="{{key}}">
                            <span class="{{key}}">
                                {{value}}
                            </span>
                    </td>
                {{/useridentityvalues}}
            </tr>
        {{/reg_data}}

        {{#mreg_data}}
            <tr class="grouptool-sortable-user"
                data-firstname="{{firstname}}"
                data-lastname="{{lastname}}">

                <td class="status">
                    {{status}}
                </td>

                <td class="userlink">
                    <a href="{{userlink}}&id={{userid}}"
                    title="{{name}}">
                    {{name}}
                    </a>
                </td>

                {{#useridentityvalues}}
                    <td class="{{key}}">
                            <span class="{{key}}">
                                {{value}}
                            </span>
                    </td>
                {{/useridentityvalues}}
            </tr>
        {{/mreg_data}}

        {{^reg_data}}
            {{^mreg_data}}
                <tr class="regentry reg grouptool-static-row">
                    <td class="no_registrations"
                        colspan="100">
                        {{#str}}no_registrations, mod_grouptool{{/str}}
                    </td>
                </tr>
            {{/mreg_data}}
        {{/reg_data}}

        {{#queue_data}}
            <tr class="grouptool-sortable-user"
                data-firstname="{{firstname}}"
                data-lastname="{{lastname}}">

                <td class="status">
                    {{rank}}
                </td>

                <td class="userlink">
                    <a href="{{userlink}}&id={{userid}}"
                    title="{{name}}">
                    {{name}}
                    </a>
                </td>

                {{#useridentityvalues}}
                    <td class="{{key}}">
                            <span class="{{key}}">
                                {{value}}
                            </span>
                    </td>
                {{/useridentityvalues}}
            </tr>
        {{/queue_data}}

        {{^queue_data}}
            <tr class="queueentry queue grouptool-static-row">
                <td class="no_queues"
                    colspan="100">
                    {{#str}}nobody_queued, mod_grouptool{{/str}}
                </td>
            </tr>
        {{/queue_data}}
        </tbody>
    </table>
</div>